{
  "name": "loan-tracker",
  "version": "1.16.0",
  "description": "Zero-install browser-based loan tracker",
  "scripts": {
    "build": "node build.js",
    "build:pages": "node build.js && node -e \"const f=require('fs');f.mkdirSync('dist',{recursive:true});f.copyFileSync('loan-tracker.html','dist/index.html')\"",
    "test": "node --test test/regression.js test/api-state.test.mjs test/sync.test.js",
    "test:update": "node test/regression.js --update-snapshots"
  }
}
